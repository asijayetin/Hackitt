{
  "info": {
    "name": "Hackitt API",
    "description": "Basic API demo: signup, login, list participants, generate teams, list teams and join a team.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "organizerToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "hackathonId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Organizer signup (run once with a unique email)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Hackitt\",\n  \"lastName\": \"Organizer\",\n  \"email\": \"organizer@example.com\",\n  \"password\": \"pass123\",\n  \"role\": \"organizer\"\n}" },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "Student signup (run once with a unique email)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Aditi\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"student@example.com\",\n  \"password\": \"pass123\",\n  \"role\": \"student\",\n  \"skill\": \"Frontend\"\n}" },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "Organizer login (copy token from response to organizerToken)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"organizer@example.com\",\n  \"password\": \"pass123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Student login (copy token from response to studentToken)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"pass123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Get participants",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "url": "{{baseUrl}}/participants" }
    },
    {
      "name": "Create hackathon",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hackitt Summer Jam\",\n  \"description\": \"Build a useful student project\",\n  \"minTeamSize\": 3,\n  \"maxTeamSize\": 4,\n  \"requiredSkills\": [\"Frontend\", \"Backend\", \"Design\"]\n}" }, "url": "{{baseUrl}}/hackathons" }
    },
    {
      "name": "List my hackathons",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "url": "{{baseUrl}}/hackathons" }
    },
    {
      "name": "Student sees open hackathons",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/hackathons" }
    },
    {
      "name": "Join a hackathon (set hackathonId from list response)",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/hackathons/{{hackathonId}}/join" }
    },
      {
        "name": "Generate teams",
        "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"teamSize\": 4,\n  \"teamCount\": 3\n}" }, "url": "{{baseUrl}}/teams/generate" }
      },
      {
        "name": "Get waiting students",
        "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "url": "{{baseUrl}}/teams/pending" }
      },
      {
        "name": "Send team change request",
        "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{studentToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"My skills match another team better\"\n}" }, "url": "{{baseUrl}}/team-change-requests" }
      },
      {
        "name": "Review team change requests",
        "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "url": "{{baseUrl}}/team-change-requests" }
      },
    {
      "name": "Get teams (copy a team's _id to teamId)",
      "request": { "method": "GET", "url": "{{baseUrl}}/teams" }
    },
    {
      "name": "Join team",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/teams/{{teamId}}/join" }
    }
  ]
}
